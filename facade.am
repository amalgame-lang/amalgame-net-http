// amalgame-net-http — pure-Amalgame HTTP/1.1 client + server.
//
// Compiled by `amc package add` through:
//   amc --lib --quiet facade.am -o build/<plat>/AmalgameNetHttp-facade
//   gcc -c build/<plat>/AmalgameNetHttp-facade.c -o ...
//   ar  rcs build/<plat>/libamalgame-pkg-HttpRequest.a ...
//
// User code that imports Amalgame.Net.Http gets forward decls only;
// symbols resolve at link time from the per-package archive.
//
// Architecture:
//   - HTTP/1.1 parsing is 100% pure AM (string manipulation —
//     Amalgame's strength).
//   - Socket I/O delegates to amalgame-net (Amalgame.Net.TcpServer /
//     TcpClient).
//   - HTTPS delegates to amalgame-tls (Amalgame.Tls.TlsStream).
//   - HTTP/2 will arrive in a v0.1.x via the C runtime header (nghttp2
//     binding); the AM-side API stays the same.

namespace Amalgame.Net.Http

import Amalgame.Collections
import Amalgame.String
import Amalgame.Net

// NOTE: TLS integration (server-side HTTPS, client HTTPS, ALPN) is
// deferred to v0.1.x. v0.1 keeps `tlsCtx` parameters typed as `any`
// (always null) so we don't impose a build-time dependency on
// amalgame-tls. v0.1.x will swap `any → any` and add the
// `import Amalgame.Tls` once the package mechanism wires it through.

// ─────────────────────────────────────────────────────────────────
// Cookie — utility type, parsed from `Cookie:` request header or
// emitted via `HttpResponse.SetCookie()`.
// ─────────────────────────────────────────────────────────────────

public class Cookie {
    public Name:     string
    public Value:    string
    public Domain:   string
    public Path:     string
    public MaxAgeSec: int
    public HttpOnly: bool
    public Secure:   bool
    public SameSite: string   // "Lax" (default) | "Strict" | "None"

    public Cookie() {
        this.Name      = ""
        this.Value     = ""
        this.Domain    = ""
        this.Path      = "/"
        this.MaxAgeSec = 0
        this.HttpOnly  = true
        this.Secure    = false
        this.SameSite  = "Lax"
    }

    // Serialize the cookie to a `Set-Cookie:` header value.
    public string ToHeader() {
        var s: string = this.Name + "=" + this.Value
        if (String_Length(this.Path) > 0)    { s = s + "; Path=" + this.Path }
        if (String_Length(this.Domain) > 0)  { s = s + "; Domain=" + this.Domain }
        if (this.MaxAgeSec > 0)              { s = s + "; Max-Age=" + String_FromInt(this.MaxAgeSec) }
        if (this.HttpOnly)                   { s = s + "; HttpOnly" }
        if (this.Secure)                     { s = s + "; Secure" }
        if (String_Length(this.SameSite) > 0) { s = s + "; SameSite=" + this.SameSite }
        return s
    }
}

// ─────────────────────────────────────────────────────────────────
// HttpRequest — one incoming HTTP request after parsing.
// ─────────────────────────────────────────────────────────────────

public class HttpRequest {
    public Method:      string                    // "GET" / "POST" / ...
    public Path:        string                    // "/users/42" (no query)
    public RawTarget:   string                    // "/users/42?x=1" (with query)
    public HttpVersion: string                    // "HTTP/1.1" or "HTTP/2"
    public Headers:     Map<string, string>       // header name lowercased → value
    public Query:       Map<string, string>       // parsed query string
    public Body:        string                    // raw body bytes (text-safe)
    public RemoteAddr:  string                    // client IP:port
    public IsSecure:    bool                      // true if served over TLS

    public HttpRequest() {
        this.Method      = ""
        this.Path        = ""
        this.RawTarget   = ""
        this.HttpVersion = ""
        this.Headers     = new Map<string, string>()
        this.Query       = new Map<string, string>()
        this.Body        = ""
        this.RemoteAddr  = ""
        this.IsSecure    = false
    }

    // Get a header value (case-insensitive lookup).
    public string Header(string name) {
        let key: string = String_ToLower(name)
        if (this.Headers.Has(key)) { return this.Headers.Get(key) }
        return ""
    }

    // Parse Body as a urlencoded form (Content-Type application/x-www-form-urlencoded).
    public Map<string, string> Form() {
        return HttpRequest.ParseQuery(this.Body)
    }

    // Body as plain text (already a string in v0.1).
    public string BodyText() { return this.Body }

    // Extract a cookie value by name from the Cookie: header.
    public string Cookie(string name) {
        let raw: string = this.Header("cookie")
        if (String_Length(raw) == 0) { return "" }
        let parts: List<string> = String_Split(raw, ";")
        let pn: int = parts.Count()
        for i in 0..pn {
            let p: string = String_Trim(parts.Get(i))
            let eq: int = String_IndexOf(p, "=")
            if (eq < 0) { continue }
            let k: string = String_Substring(p, 0, eq)
            if (k == name) {
                return String_Substring(p, eq + 1, String_Length(p) - eq - 1)
            }
        }
        return ""
    }

    // ── Internal parser helpers ────────────────────────────────────

    // Parse a urlencoded key=value&... string into a map.
    public static Map<string, string> ParseQuery(string s) {
        let out = new Map<string, string>()
        if (String_Length(s) == 0) { return out }
        let pairs: List<string> = String_Split(s, "&")
        let pn: int = pairs.Count()
        for i in 0..pn {
            let p: string = pairs.Get(i)
            if (String_Length(p) == 0) { continue }
            let eq: int = String_IndexOf(p, "=")
            if (eq < 0) {
                out.Set(HttpRequest.UrlDecode(p), "")
            } else {
                let k: string = String_Substring(p, 0, eq)
                let v: string = String_Substring(p, eq + 1, String_Length(p) - eq - 1)
                out.Set(HttpRequest.UrlDecode(k), HttpRequest.UrlDecode(v))
            }
        }
        return out
    }

    // Minimal urldecode: %HH escapes + '+' → space. Invalid sequences
    // pass through unchanged. Uses String_CharAt1 (returns single-char
    // string) — the AM convention. Hex digits are compared as strings
    // since we don't have a string→int codepoint helper at AM level.
    public static string UrlDecode(string s) {
        var out: string = ""
        let n: int = String_Length(s)
        var i: int = 0
        while (i < n) {
            let c: string = String_CharAt1(s, i)
            if (c == "%" && i + 2 < n) {
                let h1: int = HttpRequest.HexDigit(String_CharAt1(s, i + 1))
                let h2: int = HttpRequest.HexDigit(String_CharAt1(s, i + 2))
                if (h1 >= 0 && h2 >= 0) {
                    out = out + String_FromByte(h1 * 16 + h2)
                    i = i + 3
                    continue
                }
            }
            if (c == "+") {
                out = out + " "
            } else {
                out = out + c
            }
            i = i + 1
        }
        return out
    }

    // Decode a single hex digit char ("0"-"9","a"-"f","A"-"F") → 0-15,
    // -1 if not a hex digit.
    private static int HexDigit(string c) {
        if (c == "0") { return 0 }
        if (c == "1") { return 1 }
        if (c == "2") { return 2 }
        if (c == "3") { return 3 }
        if (c == "4") { return 4 }
        if (c == "5") { return 5 }
        if (c == "6") { return 6 }
        if (c == "7") { return 7 }
        if (c == "8") { return 8 }
        if (c == "9") { return 9 }
        if (c == "a" || c == "A") { return 10 }
        if (c == "b" || c == "B") { return 11 }
        if (c == "c" || c == "C") { return 12 }
        if (c == "d" || c == "D") { return 13 }
        if (c == "e" || c == "E") { return 14 }
        if (c == "f" || c == "F") { return 15 }
        return -1
    }
}

// ─────────────────────────────────────────────────────────────────
// HttpResponse — one outgoing HTTP response, built via fluent API.
// Wire serialization is internal (in `Render()`); user code never
// touches the bytes.
// ─────────────────────────────────────────────────────────────────

public class HttpResponse {
    public StatusCode:  int                       // default 200
    public Headers:     Map<string, string>
    public BodyText:    string

    public HttpResponse() {
        this.StatusCode = 200
        this.Headers    = new Map<string, string>()
        this.BodyText   = ""
    }

    public static HttpResponse New() { return new HttpResponse() }

    public HttpResponse Status(int code) {
        this.StatusCode = code
        return this
    }

    public HttpResponse Header(string name, string value) {
        this.Headers.Set(name, value)
        return this
    }

    public HttpResponse Text(string s) {
        this.BodyText = s
        if (!this.Headers.Has("Content-Type")) {
            this.Headers.Set("Content-Type", "text/plain; charset=utf-8")
        }
        return this
    }

    public HttpResponse Html(string s) {
        this.BodyText = s
        this.Headers.Set("Content-Type", "text/html; charset=utf-8")
        return this
    }

    public HttpResponse Json(string jsonText) {
        this.BodyText = jsonText
        this.Headers.Set("Content-Type", "application/json")
        return this
    }

    public HttpResponse Redirect(string url, bool permanent) {
        if (permanent) {
            this.StatusCode = 308
        } else {
            this.StatusCode = 302
        }
        this.Headers.Set("Location", url)
        return this
    }

    public HttpResponse SetCookie(Cookie c) {
        this.Headers.Set("Set-Cookie", c.ToHeader())
        return this
    }

    // Serialize to wire bytes — used by HttpServer.
    public string Render() {
        let crlf: string = String_FromByte(13) + "\n"
        let phrase: string = HttpResponse.ReasonPhrase(this.StatusCode)
        var s: string = "HTTP/1.1 " + String_FromInt(this.StatusCode) + " " + phrase + crlf
        // Content-Length is mandatory in HTTP/1.1 unless chunked.
        this.Headers.Set("Content-Length", String_FromInt(String_Length(this.BodyText)))
        let keys: List<string> = this.Headers.Keys()
        let kn: int = keys.Count()
        for i in 0..kn {
            let k: string = keys.Get(i)
            s = s + k + ": " + this.Headers.Get(k) + crlf
        }
        s = s + crlf + this.BodyText
        return s
    }

    // Standard reason phrases for common codes. Unknown → "Status".
    private static string ReasonPhrase(int code) {
        if (code == 200) { return "OK" }
        if (code == 201) { return "Created" }
        if (code == 204) { return "No Content" }
        if (code == 301) { return "Moved Permanently" }
        if (code == 302) { return "Found" }
        if (code == 304) { return "Not Modified" }
        if (code == 308) { return "Permanent Redirect" }
        if (code == 400) { return "Bad Request" }
        if (code == 401) { return "Unauthorized" }
        if (code == 403) { return "Forbidden" }
        if (code == 404) { return "Not Found" }
        if (code == 405) { return "Method Not Allowed" }
        if (code == 409) { return "Conflict" }
        if (code == 413) { return "Payload Too Large" }
        if (code == 415) { return "Unsupported Media Type" }
        if (code == 429) { return "Too Many Requests" }
        if (code == 500) { return "Internal Server Error" }
        if (code == 502) { return "Bad Gateway" }
        if (code == 503) { return "Service Unavailable" }
        return "Status"
    }
}

// ─────────────────────────────────────────────────────────────────
// HTTP/1.1 wire parser. Public so library users / tests can exercise
// it directly, and so HttpServer / HttpClient can share one impl.
// ─────────────────────────────────────────────────────────────────

public class HttpParser {
    // Build the CRLF separator. AM string literals don't escape `\r`
    // (only `\n` is recognized), so a literal `"\r\n"` lexes as 3
    // bytes (`\`, `r`, LF) instead of the 2-byte HTTP standard
    // (CR LF). We assemble CR explicitly from its byte value.
    public static string Crlf() { return String_FromByte(13) + "\n" }

    public static string DoubleCrlf() {
        let crlf: string = String_FromByte(13) + "\n"
        return crlf + crlf
    }

    // Parse the request-line + header block. Body is NOT read here —
    // the caller must look at Content-Length / Transfer-Encoding and
    // fetch the right number of bytes from the socket.
    //
    // Returns a partially-populated HttpRequest, or null on parse
    // error. `headerBlock` is everything up to and including the
    // empty CRLF that separates headers from body.
    public static HttpRequest ParseHeaders(string headerBlock) {
        let crlf: string = HttpParser.Crlf()
        let lines: List<string> = String_Split(headerBlock, crlf)
        if (lines.Count() < 1) { return null }

        // First line: "METHOD SP REQUEST-TARGET SP HTTP-VERSION".
        let first: string = lines.Get(0)
        let sp1: int = String_IndexOf(first, " ")
        if (sp1 < 0) { return null }
        let rest: string = String_Substring(first, sp1 + 1, String_Length(first) - sp1 - 1)
        let sp2: int = String_IndexOf(rest, " ")
        if (sp2 < 0) { return null }

        let req = new HttpRequest()
        req.Method      = String_Substring(first, 0, sp1)
        req.RawTarget   = String_Substring(rest, 0, sp2)
        req.HttpVersion = String_Substring(rest, sp2 + 1, String_Length(rest) - sp2 - 1)

        // Split request-target into Path + Query.
        let qIdx: int = String_IndexOf(req.RawTarget, "?")
        if (qIdx < 0) {
            req.Path = req.RawTarget
        } else {
            req.Path  = String_Substring(req.RawTarget, 0, qIdx)
            let q: string = String_Substring(req.RawTarget, qIdx + 1,
                                              String_Length(req.RawTarget) - qIdx - 1)
            req.Query = HttpRequest.ParseQuery(q)
        }

        // Header block — each "Name: Value" until empty line.
        let ln: int = lines.Count()
        for i in 1..ln {
            let line: string = lines.Get(i)
            if (String_Length(line) == 0) { continue }
            let colon: int = String_IndexOf(line, ":")
            if (colon < 0) { continue }
            let name: string = String_Trim(String_Substring(line, 0, colon))
            let value: string = String_Trim(
                String_Substring(line, colon + 1, String_Length(line) - colon - 1))
            req.Headers.Set(String_ToLower(name), value)
        }
        return req
    }

    // Convenience: parse a complete request including body. Used by
    // the test suite; production servers stream the body separately
    // to enforce Content-Length / timeout limits.
    public static HttpRequest ParseFull(string raw) {
        let sep: string = HttpParser.DoubleCrlf()
        let sepLen: int = String_Length(sep)
        let idx: int = String_IndexOf(raw, sep)
        if (idx < 0) { return null }
        let headerBlock: string = String_Substring(raw, 0, idx)
        let req: HttpRequest = HttpParser.ParseHeaders(headerBlock)
        if (req == null) { return null }
        let bodyStart: int = idx + sepLen
        req.Body = String_Substring(raw, bodyStart, String_Length(raw) - bodyStart)
        return req
    }

    // Parse an HTTP response (used by HttpClient). Returns a tuple-ish
    // via a populated HttpResponse + body string. Same caveat as
    // ParseFull: full message in memory.
    public static HttpResponse ParseResponse(string raw) {
        let sep: string = HttpParser.DoubleCrlf()
        let sepLen: int = String_Length(sep)
        let idx: int = String_IndexOf(raw, sep)
        if (idx < 0) { return null }
        let headerBlock: string = String_Substring(raw, 0, idx)
        let lines: List<string> = String_Split(headerBlock, HttpParser.Crlf())
        if (lines.Count() < 1) { return null }

        // Status line: "HTTP/1.1 SP CODE SP REASON".
        let first: string = lines.Get(0)
        let sp1: int = String_IndexOf(first, " ")
        if (sp1 < 0) { return null }
        let rest: string = String_Substring(first, sp1 + 1, String_Length(first) - sp1 - 1)
        let sp2: int = String_IndexOf(rest, " ")
        let code: int = 0
        if (sp2 < 0) {
            code = String_ToInt(rest)
        } else {
            code = String_ToInt(String_Substring(rest, 0, sp2))
        }
        let resp = HttpResponse.New().Status(code)

        let ln: int = lines.Count()
        for i in 1..ln {
            let line: string = lines.Get(i)
            if (String_Length(line) == 0) { continue }
            let colon: int = String_IndexOf(line, ":")
            if (colon < 0) { continue }
            let name: string = String_Trim(String_Substring(line, 0, colon))
            let value: string = String_Trim(
                String_Substring(line, colon + 1, String_Length(line) - colon - 1))
            resp.Headers.Set(name, value)
        }

        let bodyStart: int = idx + 4
        resp.BodyText = String_Substring(raw, bodyStart, String_Length(raw) - bodyStart)
        return resp
    }
}

// ─────────────────────────────────────────────────────────────────
// HttpServer — low-level helpers wrapping the parser + response
// rendering for use inside a user-written accept loop.
//
// v0.1 intentionally does NOT expose a high-level `Serve(handler)`
// API: AM lambdas are not first-class types yet (no `Function`
// type that can be stored or passed as a method parameter), and
// stdlib types like `AmalgameTcpServer*` can't be used as class
// field types. Both will become workable in v0.1.x.
//
// User pattern v0.1:
//
//   import Amalgame.Net.Http
//   import Amalgame.Net
//
//   let srv = TcpServer_Listen(3000, 128)
//   while (TcpServer_IsListening(srv)) {
//       let conn = TcpServer_Accept(srv)
//       let raw  = TcpConn_Receive(conn, 65536)
//       let req  = HttpParser.ParseFull(raw)
//       if (req != null) {
//           let resp = HttpResponse.New().Text("Hello " + req.Path)
//           TcpConn_Send(conn, resp.Render())
//       }
//       TcpConn_Close(conn)
//   }
//   TcpServer_Close(srv)
//
// Everything from this section is also available statically (no
// HttpServer instance needed). Convenience wrappers below.
// ─────────────────────────────────────────────────────────────────

public class HttpServer {
    // Format a 400 Bad Request body (for malformed requests).
    public static string BadRequestResponse() {
        let crlf: string = String_FromByte(13) + "\n"
        return "HTTP/1.1 400 Bad Request" + crlf + "Content-Length: 0" + crlf + "Connection: close" + crlf + crlf
    }

    // Format a 500 Internal Server Error body.
    public static string InternalErrorResponse() {
        let crlf: string = String_FromByte(13) + "\n"
        return "HTTP/1.1 500 Internal Server Error" + crlf + "Content-Length: 0" + crlf + "Connection: close" + crlf + crlf
    }

    // Format a 404 Not Found body with a one-line plain-text message.
    public static string NotFoundResponse() {
        let crlf: string = String_FromByte(13) + "\n"
        return "HTTP/1.1 404 Not Found" + crlf + "Content-Type: text/plain" + crlf + "Content-Length: 9" + crlf + "Connection: close" + crlf + crlf + "Not found"
    }
}


// ─────────────────────────────────────────────────────────────────
// HttpClient — small surface for the common GET/POST cases.
//
// For complex requests (custom method, headers, body type) use
// HttpRequestBuilder via `HttpClient.Request(...)`.
// ─────────────────────────────────────────────────────────────────

public class HttpRequestBuilder {
    public Method:  string
    public Url:     string
    public Headers: Map<string, string>
    public Body:    string

    public HttpRequestBuilder() {
        this.Method  = "GET"
        this.Url     = ""
        this.Headers = new Map<string, string>()
        this.Body    = ""
    }

    public HttpRequestBuilder Header(string name, string value) {
        this.Headers.Set(name, value)
        return this
    }
    public HttpRequestBuilder BodyText(string s) {
        this.Body = s
        return this
    }
    public HttpRequestBuilder BodyJson(string jsonText) {
        this.Body = jsonText
        this.Headers.Set("Content-Type", "application/json")
        return this
    }
    public HttpRequestBuilder BodyForm(Map<string, string> form) {
        var s: string = ""
        let keys: List<string> = form.Keys()
        let kn: int = keys.Count()
        for i in 0..kn {
            if (i > 0) { s = s + "&" }
            s = s + keys.Get(i) + "=" + form.Get(keys.Get(i))
        }
        this.Body = s
        this.Headers.Set("Content-Type", "application/x-www-form-urlencoded")
        return this
    }

    public HttpResponse Send() {
        return HttpClient.Execute(this)
    }
}

// Internal helper — parsed URL components. Defined before HttpClient
// because amc's cgen requires struct field types to be complete at
// the point of access (forward-decl is fine for typedefs only).
public class ParsedUrl {
    public Scheme: string    // "http" / "https"
    public Host:   string
    public Port:   int
    public Path:   string

    public ParsedUrl() {
        this.Scheme = ""
        this.Host   = ""
        this.Port   = 0
        this.Path   = "/"
    }
}

public class HttpClient {
    // Quick GET — returns the response (or a stub 0 if connect fails).
    public static HttpResponse Get(string url) {
        let b = new HttpRequestBuilder()
        b.Method = "GET"
        b.Url    = url
        return HttpClient.Execute(b)
    }
    public static HttpResponse Post(string url, string body, string contentType) {
        let b = new HttpRequestBuilder()
        b.Method = "POST"
        b.Url    = url
        b.Body   = body
        b.Headers.Set("Content-Type", contentType)
        return HttpClient.Execute(b)
    }
    public static HttpRequestBuilder Request(string method, string url) {
        let b = new HttpRequestBuilder()
        b.Method = method
        b.Url    = url
        return b
    }

    // Internal — parse URL, open socket (TCP or TLS), send request,
    // read response. Plain HTTP only in v0.1 (HTTPS arrives once
    // we wire amalgame-tls fully — same socket plumbing).
    public static HttpResponse Execute(HttpRequestBuilder b) {
        // Parse URL: <scheme>://<host>[:<port>]/<path>
        let u: ParsedUrl = HttpClient.ParseUrl(b.Url)
        if (u == null || String_Length(u.Host) == 0) {
            return HttpResponse.New().Status(0).Text("invalid url")
        }
        let isTls: bool = u.Scheme == "https"
        let port: int = u.Port
        if (port == 0) { port = isTls ? 443 : 80 }

        // Build request bytes.
        let crlf: string = String_FromByte(13) + "\n"
        let cl: int = String_Length(b.Body)
        var s: string = b.Method + " " + u.Path + " HTTP/1.1" + crlf
        s = s + "Host: " + u.Host + crlf
        s = s + "Content-Length: " + String_FromInt(cl) + crlf
        s = s + "Connection: close" + crlf
        let hk: List<string> = b.Headers.Keys()
        let hn: int = hk.Count()
        for i in 0..hn {
            let k: string = hk.Get(i)
            s = s + k + ": " + b.Headers.Get(k) + crlf
        }
        s = s + crlf + b.Body

        // Plain TCP path — HTTPS path lands in v0.1.x.
        let conn = TcpClient_Connect(u.Host, port)
        if (!TcpClient_IsConnected(conn)) {
            return HttpResponse.New().Status(0).Text("connect failed")
        }
        TcpClient_Send(conn, s)
        let raw: string = TcpClient_Receive(conn, 1048576)   // 1 MB cap
        TcpClient_Close(conn)
        if (raw == null) {
            return HttpResponse.New().Status(0).Text("read failed")
        }
        let resp: HttpResponse = HttpParser.ParseResponse(raw)
        if (resp == null) {
            return HttpResponse.New().Status(0).Text("invalid response")
        }
        return resp
    }

    private static ParsedUrl ParseUrl(string url) {
        let p = new ParsedUrl()
        let schemeSep: int = String_IndexOf(url, "://")
        if (schemeSep < 0) { return null }
        p.Scheme = String_Substring(url, 0, schemeSep)
        let rest: string = String_Substring(url, schemeSep + 3, String_Length(url) - schemeSep - 3)
        let slashIdx: int = String_IndexOf(rest, "/")
        var hostPort: string = rest
        if (slashIdx < 0) {
            p.Path = "/"
        } else {
            hostPort = String_Substring(rest, 0, slashIdx)
            p.Path   = String_Substring(rest, slashIdx, String_Length(rest) - slashIdx)
        }
        let colonIdx: int = String_IndexOf(hostPort, ":")
        if (colonIdx < 0) {
            p.Host = hostPort
            p.Port = 0
        } else {
            p.Host = String_Substring(hostPort, 0, colonIdx)
            p.Port = String_ToInt(
                String_Substring(hostPort, colonIdx + 1,
                                  String_Length(hostPort) - colonIdx - 1))
        }
        return p
    }
}

