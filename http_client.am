// amalgame-net-http — HttpRequestBuilder + ParsedUrl + HttpClient.
//
// Lives in its own file since v0.4.6 split (was in facade.am
// v0.4.5 and earlier). No behavior change vs the previous combined
// file — just locality.

namespace Amalgame.Net.Http

import Amalgame.Collections
import Amalgame.String

// v0.11.0: HTTPS client support. We pull amalgame-tls in via the
// runtime header only (no AM-side import) — the Tls* classes
// aren't reachable at AM resolution time when downstream tests
// only `--external` net-http's own sources, so we call the C
// primitives directly from @c blocks. The full TLS context setup
// stays a single static-inline call away.
@c {
    #include "Amalgame_Tls.h"
    #ifndef _WIN32
      #include <netdb.h>   /* getaddrinfo; on Windows it comes from
                            * winsock2/ws2tcpip via Amalgame_Tls.h */
      #include <sys/socket.h>
    #endif
    #include <string.h>
    #include <strings.h>   /* strncasecmp */
    #include <stdio.h>     /* binary download → FILE* */
    #include <stdlib.h>
    #include <errno.h>
    #include <openssl/x509v3.h>   /* X509_VERIFY_PARAM_set1_ip_asc, X509_CHECK_FLAG_* */
    #include <openssl/evp.h>      /* EVP_EncodeBlock (proxy credentials) */

    /* v0.29.9 — the server's NAME is checked, not only its chain.
     * Until then the client verified that the certificate was signed by
     * a trusted CA, but not that it was issued for the host it called :
     * anyone on the path holding any valid certificate (for their own
     * domain) could impersonate the server and read the request — an
     * API key, a password. The host is pinned on the SSL object before
     * the handshake : a DNS name with SSL_set1_host (no partial
     * wildcards), an IP literal with X509_VERIFY_PARAM_set1_ip_asc.
     * A mismatch fails the handshake (SSL_VERIFY_PEER). Returns 0 when
     * the host could not be pinned (the caller refuses the request). */
    static int amnh_pin_host(SSL* ssl, const char* host) {
        if (!ssl || !host || !host[0]) return 0;
        unsigned char ipbuf[16];
        if (inet_pton(AF_INET, host, ipbuf) == 1 || inet_pton(AF_INET6, host, ipbuf) == 1) {
            return X509_VERIFY_PARAM_set1_ip_asc(SSL_get0_param(ssl), host) == 1;
        }
        SSL_set_hostflags(ssl, X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS);
        return SSL_set1_host(ssl, host) == 1;
    }

    /* v0.29.9 — a read/write timeout on the socket : `ms` of SILENCE
     * (not a total), so a large slow body still comes through. */
    static void amnh_set_timeout(int fd, long ms) {
        if (fd < 0 || ms <= 0) return;
        #ifdef _WIN32
        DWORD t = (DWORD) ms;
        setsockopt((SOCKET) fd, SOL_SOCKET, SO_RCVTIMEO, (const char*) &t, sizeof(t));
        setsockopt((SOCKET) fd, SOL_SOCKET, SO_SNDTIMEO, (const char*) &t, sizeof(t));
        #else
        struct timeval tv; tv.tv_sec = ms / 1000; tv.tv_usec = (ms % 1000) * 1000;
        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
        #endif
    }
    /* After a failed read : 1 = interrupted (a signal — the GC's stop
     * signals among them), read again ; 2 = the timeout ; 0 = the end. */
    static int amnh_read_failed(void) {
        #ifdef _WIN32
        int w = WSAGetLastError();
        if (w == WSAEINTR) return 1;
        if (w == WSAETIMEDOUT || w == WSAEWOULDBLOCK) return 2;
        return 0;
        #else
        if (errno == EINTR) return 1;
        if (errno == EAGAIN || errno == EWOULDBLOCK) return 2;
        return 0;
        #endif
    }
    /* v0.30.0 — a CONNECT tunnel through an HTTP proxy, on a connected fd :
     * "CONNECT host:port", optional Basic credentials, then the proxy's
     * status line. Returns the status (200 = tunnel open), -1 on I/O error.
     * The proxy's reply is read byte by byte up to the blank line, so not a
     * byte of the tunnel (the server's TLS) is consumed. */
    static int amnh_tunnel(int fd, const char* host, int port, const char* auth) {
        if (fd < 0 || !host) return -1;
        char req[1024];
        int n;
        if (auth && auth[0]) n = snprintf(req, sizeof(req), "CONNECT %s:%d HTTP/1.1\r\nHost: %s:%d\r\nProxy-Authorization: Basic %s\r\n\r\n", host, port, host, port, auth);
        else n = snprintf(req, sizeof(req), "CONNECT %s:%d HTTP/1.1\r\nHost: %s:%d\r\n\r\n", host, port, host, port);
        if (n <= 0 || n >= (int) sizeof(req)) return -1;
        long sent = 0;
        while (sent < n) {
            errno = 0;
            long w = (long) send(fd, req + sent, (size_t)(n - sent), 0);
            if (w < 0 && amnh_read_failed() == 1) continue;
            if (w <= 0) return -1;
            sent += w;
        }
        char buf[8192]; int got = 0;
        while (got < (int) sizeof(buf) - 1) {
            errno = 0;
            long r = (long) recv(fd, buf + got, 1, 0);
            if (r < 0 && amnh_read_failed() == 1) continue;
            if (r <= 0) return -1;
            got += 1; buf[got] = 0;
            if (got >= 4 && memcmp(buf + got - 4, "\r\n\r\n", 4) == 0) break;
        }
        char* sp = strchr(buf, ' ');
        return sp ? atoi(sp + 1) : -1;
    }

    /* The TLS handshake, started again when a signal interrupted it. */
    static int amnh_handshake(AmalgameTlsStream* st) {
        for (int tries = 0; tries < 20; tries++) {
            errno = 0;
            if (Amalgame_Tls_TlsStream_Handshake(st)) return 1;
            if (amnh_read_failed() != 1) return 0;
        }
        return 0;
    }

    /* v0.27.0 — binary-safe download-to-file plumbing. Reading a binary
     * response into an AM string truncates at the first NUL; instead we
     * stream the response body straight to a FILE* on disk. */
    static long amnh_rd(AmalgameTlsStream* st, int fd, char* buf, long n) {
        for (;;) {   /* v0.29.9 : read again when a signal interrupted the read */
            errno = 0;
            long r = st ? (long) Amalgame_Tls_TlsStream_ReadBytes(st, buf, (i64) n)
                        : (long) recv(fd, buf, (size_t) n, 0);
            if (r < 0 && amnh_read_failed() == 1) continue;
            return r;
        }
    }
    static long amnh_wr(AmalgameTlsStream* st, int fd, const char* buf, long n) {
        if (st) return (long) Amalgame_Tls_TlsStream_WriteBytes(st, (char*) buf, (i64) n);
        return (long) send(fd, buf, (size_t) n, 0);
    }
    /* One request over `fd` (TLS-wrapped when isTls). Returns 0 = body
     * written to outPath, 1 = redirect (*loc set, caller re-requests),
     * <0 = error (incl. -100-status when status != 200). Handles
     * Content-Length and read-until-close; refuses chunked (-7) since the
     * GitHub release CDN serves Content-Length. */
    static int amnh_dl_once(int fd, int isTls, const char* host,
                            const char* req, const char* outPath, char** loc) {
        AmalgameTlsStream* st = NULL;
        if (isTls) {
            AmalgameTlsConfig* cfg = Amalgame_Tls_TlsConfig_Default();
            cfg = Amalgame_Tls_TlsConfig_WithAlpn(cfg, "http/1.1");
            AmalgameTlsContext* ctx = _amtls_new_ctx(cfg, false);
            if (!ctx || !ctx->_ctx) return -2;
            st = Amalgame_Tls_TlsStream_Wrap((i64) fd, ctx, false);
            if (st && st->_ssl && host) SSL_set_tlsext_host_name((SSL*) st->_ssl, host);
            if (!st || !st->_ssl || !amnh_pin_host((SSL*) st->_ssl, host) || !amnh_handshake(st)) {
                if (st) Amalgame_Tls_TlsStream_Close(st);
                return -3;
            }
        }
        long rlen = (long) strlen(req);
        if (amnh_wr(st, fd, req, rlen) < 0) {
            if (st) Amalgame_Tls_TlsStream_Close(st);
            return -4;
        }
        char hdr[16384]; int hl = 0; int hdrEnd = -1;
        while (hl < (int) sizeof(hdr) - 1) {
            long rn = amnh_rd(st, fd, hdr + hl, (long) sizeof(hdr) - 1 - hl);
            if (rn <= 0) break;
            hl += (int) rn; hdr[hl] = 0;
            char* p = strstr(hdr, "\r\n\r\n");
            if (p) { hdrEnd = (int)(p - hdr) + 4; break; }
        }
        if (hdrEnd < 0) { if (st) Amalgame_Tls_TlsStream_Close(st); return -5; }
        int status = 0;
        { char* sp = strchr(hdr, ' '); if (sp) status = atoi(sp + 1); }
        char* locp = NULL; char* clp = NULL; int chunked = 0;
        { char* line = hdr;
          while (line && line < hdr + hdrEnd) {
            char* eol = strstr(line, "\r\n");
            if (!eol || eol >= hdr + hdrEnd) break;
            int len = (int)(eol - line);
            if (len > 9  && strncasecmp(line, "location:", 9) == 0) locp = line + 9;
            else if (len > 15 && strncasecmp(line, "content-length:", 15) == 0) clp = line + 15;
            else if (len > 18 && strncasecmp(line, "transfer-encoding:", 18) == 0) {
                if (strstr(line, "chunked")) chunked = 1;
            }
            line = eol + 2;
          }
        }
        if (status >= 300 && status < 400 && locp) {
            while (*locp == ' ') locp++;
            char* e = strstr(locp, "\r\n");
            int ll = e ? (int)(e - locp) : (int) strlen(locp);
            char* out = (char*) GC_MALLOC(ll + 1);
            memcpy(out, locp, ll); out[ll] = 0; *loc = out;
            if (st) Amalgame_Tls_TlsStream_Close(st);
            return 1;
        }
        if (status != 200) { if (st) Amalgame_Tls_TlsStream_Close(st); return -100 - status; }
        if (chunked) { if (st) Amalgame_Tls_TlsStream_Close(st); return -7; }
        FILE* fp = fopen(outPath, "wb");
        if (!fp) { if (st) Amalgame_Tls_TlsStream_Close(st); return -6; }
        long bodyHave = hl - hdrEnd;
        if (bodyHave > 0) fwrite(hdr + hdrEnd, 1, (size_t) bodyHave, fp);
        long contentLen = clp ? atol(clp) : -1;
        long written = bodyHave;
        char dlbuf[65536];
        while (1) {
            if (contentLen >= 0 && written >= contentLen) break;
            long want = (long) sizeof(dlbuf);
            if (contentLen >= 0 && contentLen - written < want) want = contentLen - written;
            long rn = amnh_rd(st, fd, dlbuf, want);
            if (rn <= 0) {
                /* v0.29.9 : a body shorter than announced is an error, not a file */
                if (contentLen >= 0 && written < contentLen) {
                    fclose(fp); remove(outPath);
                    if (st) Amalgame_Tls_TlsStream_Close(st);
                    return -8;
                }
                break;
            }
            fwrite(dlbuf, 1, (size_t) rn, fp);
            written += rn;
        }
        fclose(fp);
        if (st) Amalgame_Tls_TlsStream_Close(st);
        return 0;
    }
}

// ─────────────────────────────────────────────────────────────────
// HttpClient — small surface for the common GET/POST cases.
//
// For complex requests (custom method, headers, body type) use
// HttpRequestBuilder via `HttpClient.Request(...)`.
// ─────────────────────────────────────────────────────────────────

public class HttpRequestBuilder {
    public Method:  string
    public Url:     string
    public Headers: Map<string, string>
    public Body:    string
    // v0.29.9 : milliseconds of silence before the request is given up
    // (the server says nothing, or stops halfway). A response cut by the
    // timeout is an error (Status 0, "timeout"), never a short body.
    public TimeoutMs: int
    // v0.30.0 : "http://[user:password@]host:port" ; "" = the environment
    // (HTTPS_PROXY / HTTP_PROXY / NO_PROXY) ; "none" = direct, whatever it says.
    public ProxyUrl: string

    public HttpRequestBuilder() {
        this.Method  = "GET"
        this.Url     = ""
        this.Headers = new Map<string, string>()
        this.Body    = ""
        this.TimeoutMs = 30000
        this.ProxyUrl = ""
    }

    public HttpRequestBuilder Proxy(string url) {
        this.ProxyUrl = url
        return this
    }

    public HttpRequestBuilder Timeout(int ms) {
        this.TimeoutMs = ms
        return this
    }

    public HttpRequestBuilder Header(string name, string value) {
        this.Headers.Set(name, value)
        return this
    }
    public HttpRequestBuilder BodyText(string s) {
        this.Body = s
        return this
    }
    public HttpRequestBuilder BodyJson(string jsonText) {
        this.Body = jsonText
        this.Headers.Set("Content-Type", "application/json")
        return this
    }
    public HttpRequestBuilder BodyForm(Map<string, string> form) {
        var s: string = ""
        let keys: List<string> = form.Keys()
        let kn: int = keys.Count()
        for i in 0..kn {
            if (i > 0) { s = s + "&" }
            s = s + keys.Get(i) + "=" + form.Get(keys.Get(i))
        }
        this.Body = s
        this.Headers.Set("Content-Type", "application/x-www-form-urlencoded")
        return this
    }

    public HttpResponse Send() {
        return HttpClient.Execute(this)
    }
}

// Internal helper — parsed URL components. Defined before HttpClient
// because amc's cgen requires struct field types to be complete at
// the point of access (forward-decl is fine for typedefs only).
public class ParsedUrl {
    public Scheme: string    // "http" / "https"
    public Host:   string
    public Port:   int
    public Path:   string

    public ParsedUrl() {
        this.Scheme = ""
        this.Host   = ""
        this.Port   = 0
        this.Path   = "/"
    }
}

// v0.30.0 — an HTTP proxy : "http://[user:password@]host:port".
// Auth is the base64 of "user:password" (Proxy-Authorization: Basic).
public class ProxySpec {
    public Host: string
    public Port: int
    public Auth: string
    public Bad:  string    // why the proxy setting cannot be used ("" when fine)

    public ProxySpec() {
        this.Host = ""
        this.Port = 0
        this.Auth = ""
        this.Bad  = ""
    }

    public static ProxySpec Parse(string raw) {
        let p = new ProxySpec()
        var rest: string = String_Trim(raw)
        let sep: int = String_IndexOf(rest, "://")
        if (sep >= 0) {
            let scheme: string = String_ToLower(String_Substring(rest, 0, sep))
            if (scheme != "http") { p.Bad = "proxy scheme " + scheme + " not supported (http:// only)" ; return p }
            rest = String_Substring(rest, sep + 3, String_Length(rest) - sep - 3)
        }
        let slash: int = String_IndexOf(rest, "/")
        if (slash >= 0) { rest = String_Substring(rest, 0, slash) }
        let at: int = String_LastIndexOf(rest, "@")
        if (at >= 0) {
            let userinfo: string = String_Substring(rest, 0, at)
            rest = String_Substring(rest, at + 1, String_Length(rest) - at - 1)
            var enc: string = ""
            @c {
                const char* ui = (const char*) userinfo;
                size_t ul = ui ? strlen(ui) : 0;
                char* out = (char*) GC_MALLOC(4 * ((ul + 2) / 3) + 1);
                EVP_EncodeBlock((unsigned char*) out, (const unsigned char*) ui, (int) ul);
                enc = out;
            }
            p.Auth = enc
        }
        let colon: int = String_LastIndexOf(rest, ":")
        if (colon < 0) { p.Bad = "proxy port missing (http://host:port)" ; return p }
        p.Host = String_Substring(rest, 0, colon)
        p.Port = String_ToInt(String_Substring(rest, colon + 1, String_Length(rest) - colon - 1))
        if (String_Length(p.Host) == 0 || p.Port <= 0) { p.Bad = "proxy address : http://host:port" }
        return p
    }
}

public class HttpClient {
    // v0.30.0 — the proxy for this request, or null (direct) : the
    // request's own Proxy(...) ("none" forces direct), else the environment
    // (HTTPS_PROXY for https://, HTTP_PROXY for http://, either case) unless
    // NO_PROXY names the host.
    public static ProxySpec ProxyFor(HttpRequestBuilder b, ParsedUrl u) {
        var raw: string = b.ProxyUrl
        if (raw == "none") { return null }
        if (String_Length(raw) == 0) {
            if (u.Scheme == "https") { raw = HttpClient.EnvOf("HTTPS_PROXY", "https_proxy") } else { raw = HttpClient.EnvOf("HTTP_PROXY", "http_proxy") }
            if (String_Length(raw) == 0) { return null }
            if (HttpClient.NoProxy(u.Host, HttpClient.EnvOf("NO_PROXY", "no_proxy"))) { return null }
        }
        return ProxySpec.Parse(raw)
    }

    public static string EnvOf(string a, string b) {
        var v: string = ""
        @c {
            const char* x = getenv((const char*) a);
            if (!x || !x[0]) x = getenv((const char*) b);
            if (x) v = (code_string) x;
        }
        return v
    }

    // NO_PROXY : comma-separated names ; "*" = everything ; an entry matches
    // the host itself and its subdomains (".example.com" or "example.com").
    public static bool NoProxy(string host, string list) {
        if (String_Length(list) == 0) { return false }
        let h: string = String_ToLower(host)
        let items: List<string> = String_Split(list, ",")
        let n: int = items.Count()
        for i in 0..n {
            var e: string = String_ToLower(String_Trim(items.Get(i)))
            if (String_Length(e) == 0) { continue }
            if (e == "*") { return true }
            if (String_StartsWith(e, ".")) { e = String_Substring(e, 1, String_Length(e) - 1) }
            if (h == e) { return true }
            let suffix: string = "." + e
            let hl: int = String_Length(h)
            let sl: int = String_Length(suffix)
            if (hl > sl && String_Substring(h, hl - sl, sl) == suffix) { return true }
        }
        return false
    }

    // Quick GET — returns the response (or a stub 0 if connect fails).
    public static HttpResponse Get(string url) {
        let b = new HttpRequestBuilder()
        b.Method = "GET"
        b.Url    = url
        return HttpClient.Execute(b)
    }
    public static HttpResponse Post(string url, string body, string contentType) {
        let b = new HttpRequestBuilder()
        b.Method = "POST"
        b.Url    = url
        b.Body   = body
        b.Headers.Set("Content-Type", contentType)
        return HttpClient.Execute(b)
    }
    public static HttpRequestBuilder Request(string method, string url) {
        let b = new HttpRequestBuilder()
        b.Method = method
        b.Url    = url
        return b
    }

    // SSRF-guarded GET. Refuses (Status 0 stub) when the URL host resolves
    // to a non-public address — loopback, RFC1918 private, link-local
    // (incl. the 169.254.169.254 cloud-metadata endpoint), CGNAT, IPv6
    // ULA/loopback/link-local, or IPv4-mapped equivalents. Opt-in:
    // HttpClient.Get stays unguarded so trusted internal calls (OAuth /
    // reCAPTCHA / ACME) keep working. Use GetGuarded for any URL that
    // comes from user input.
    //
    // NOTE: the guard resolves the host, then Execute resolves again, so a
    // determined attacker has a narrow DNS-rebinding TOCTOU window; this
    // blocks the common SSRF cases but isn't a substitute for pinning the
    // resolved IP through to connect().
    public static HttpResponse GetGuarded(string url) {
        let u: ParsedUrl = HttpClient.ParseUrl(url)
        if (u == null || String_Length(u.Host) == 0) {
            return HttpResponse.New().Status(0).Text("invalid url")
        }
        if (!HttpClient.HostIsPublic(u.Host)) {
            return HttpResponse.New().Status(0).Text("blocked: non-public address (SSRF guard)")
        }
        return HttpClient.Get(url)
    }

    // True iff every address `host` resolves to is global-scope. Empty
    // host or resolution failure → false (fail closed).
    public static bool HostIsPublic(string host) {
        var ok: bool = false
        @c {
            ok = 0;
            const char* h = (const char*) host;
            if (h && h[0]) {
                struct addrinfo hints; memset(&hints, 0, sizeof(hints));
                hints.ai_family = AF_UNSPEC; hints.ai_socktype = SOCK_STREAM;
                struct addrinfo* res = NULL;
                if (getaddrinfo(h, NULL, &hints, &res) == 0 && res) {
                    int all_public = 1; int any = 0;
                    for (struct addrinfo* ai = res; ai; ai = ai->ai_next) {
                        any = 1;
                        if (ai->ai_family == AF_INET) {
                            struct sockaddr_in* s = (struct sockaddr_in*) ai->ai_addr;
                            unsigned int a = ntohl(s->sin_addr.s_addr);
                            unsigned int b0 = (a >> 24) & 0xff, b1 = (a >> 16) & 0xff;
                            int priv = 0;
                            if (b0 == 10) priv = 1;
                            else if (b0 == 127) priv = 1;
                            else if (b0 == 0) priv = 1;
                            else if (b0 == 172 && b1 >= 16 && b1 <= 31) priv = 1;
                            else if (b0 == 192 && b1 == 168) priv = 1;
                            else if (b0 == 169 && b1 == 254) priv = 1;
                            else if (b0 == 100 && b1 >= 64 && b1 <= 127) priv = 1;
                            if (priv) all_public = 0;
                        } else if (ai->ai_family == AF_INET6) {
                            struct sockaddr_in6* s6 = (struct sockaddr_in6*) ai->ai_addr;
                            unsigned char* a = s6->sin6_addr.s6_addr;
                            int priv = 0;
                            if (IN6_IS_ADDR_LOOPBACK(&s6->sin6_addr)) priv = 1;
                            else if (IN6_IS_ADDR_LINKLOCAL(&s6->sin6_addr)) priv = 1;
                            else if (IN6_IS_ADDR_UNSPECIFIED(&s6->sin6_addr)) priv = 1;
                            else if ((a[0] & 0xfe) == 0xfc) priv = 1;
                            else if (IN6_IS_ADDR_V4MAPPED(&s6->sin6_addr)) {
                                unsigned int b0 = a[12], b1 = a[13];
                                if (b0==10||b0==127||b0==0||(b0==172&&b1>=16&&b1<=31)
                                    ||(b0==192&&b1==168)||(b0==169&&b1==254)
                                    ||(b0==100&&b1>=64&&b1<=127)) priv = 1;
                            }
                            if (priv) all_public = 0;
                        }
                    }
                    if (any && all_public) ok = 1;
                }
                if (res) freeaddrinfo(res);
            }
        }
        return ok
    }

    // v0.27.0 — binary-safe download to a file on disk. Unlike Get (which
    // reads the body into an AM string, truncating at the first NUL and
    // capping at 1 MiB), this streams the response body straight to
    // `path`, following up to 6 redirects (GitHub release URLs 302 to a
    // CDN). Returns true on a 200 whose body was fully written. Pair with
    // HttpResponse.File(path) to serve the cached file binary-safe.
    //
    //   if (HttpClient.DownloadToFile(assetUrl, cachePath)) { ... }
    public static bool DownloadToFile(string url, string path) {
        var cur: string = url
        var hops: int = 0
        while (hops < 6) {
            let u: ParsedUrl = HttpClient.ParseUrl(cur)
            if (u == null || String_Length(u.Host) == 0) { return false }
            let isTls: bool = u.Scheme == "https"
            var port: int = u.Port
            if (port == 0) { if (isTls) { port = 443 } else { port = 80 } }
            // v0.30.0 : through the proxy of the environment, like Execute.
            let pb = new HttpRequestBuilder()
            pb.Url = cur
            let px: ProxySpec = HttpClient.ProxyFor(pb, u)
            if (px != null && String_Length(px.Bad) > 0) { return false }
            let crlf: string = String_FromByte(13) + "\n"
            var target: string = u.Path
            var pauth: string = ""
            if (px != null && !isTls) {
                target = "http://" + u.Host + ":" + String_FromInt(port) + u.Path
                if (String_Length(px.Auth) > 0) { pauth = "Proxy-Authorization: Basic " + px.Auth + crlf }
            }
            let req: string = "GET " + target + " HTTP/1.1" + crlf
                + "Host: " + u.Host + crlf + pauth
                + "User-Agent: amalgame-net-http/0.30" + crlf
                + "Accept: */*" + crlf
                + "Connection: close" + crlf + crlf
            var connHost: string = u.Host
            var connPort: int = port
            if (px != null) { connHost = px.Host ; connPort = px.Port }
            let conn = TcpClient_Connect(connHost, connPort)
            if (!TcpClient_IsConnected(conn)) { return false }
            @c { amnh_set_timeout(conn ? conn->_fd : -1, 30000); }
            if (px != null && isTls) {
                let thost: string = u.Host
                let tauth: string = px.Auth
                var tst: int = 0
                @c { tst = amnh_tunnel(conn ? conn->_fd : -1, (const char*) thost, (int) port, (const char*) tauth); }
                if (tst != 200) { TcpClient_Close(conn) ; return false }
            }
            var rc: int = -1
            var location: string = ""
            let reqC: string = req
            let hostC: string = u.Host
            let outC: string = path
            var tlsFlag: int = 0
            if (isTls) { tlsFlag = 1 }
            @c {
                int fd = conn ? conn->_fd : -1;
                char* loc = 0;
                rc = amnh_dl_once(fd, (int) tlsFlag, (const char*) hostC,
                                  (const char*) reqC, (const char*) outC, &loc);
                if (loc) location = loc;
            }
            TcpClient_Close(conn)
            if (rc == 0) { return true }
            if (rc == 1 && String_Length(location) > 0) {
                cur = location
                hops = hops + 1
                continue
            }
            return false
        }
        return false
    }

    // Internal — parse URL, open socket (TCP or TLS), send request,
    // read response. Plain HTTP only in v0.1 (HTTPS arrives once
    // we wire amalgame-tls fully — same socket plumbing).
    public static HttpResponse Execute(HttpRequestBuilder b) {
        // Parse URL: <scheme>://<host>[:<port>]/<path>
        let u: ParsedUrl = HttpClient.ParseUrl(b.Url)
        if (u == null || String_Length(u.Host) == 0) {
            return HttpResponse.New().Status(0).Text("invalid url")
        }
        let isTls: bool = u.Scheme == "https"
        var port: int = u.Port
        // NB: pas de ternaire `? :` ici — amc le compile à tort en
        // `port = isTls` (le `? 443 : 80` est ignoré par la cgen), ce
        // qui donnait port=0 sur http:// → connect(:0) qui PEND. if/else
        // explicite. Bug amc à corriger séparément.
        if (port == 0) {
            if (isTls) { port = 443 } else { port = 80 }
        }

        // v0.30.0 — a proxy, when one applies : b.ProxyUrl, else HTTPS_PROXY
        // (https://) or HTTP_PROXY (http://), unless NO_PROXY names the host.
        let px: ProxySpec = HttpClient.ProxyFor(b, u)
        if (px != null && String_Length(px.Bad) > 0) { return HttpResponse.New().Status(0).Text(px.Bad) }

        // Build request bytes.
        let crlf: string = String_FromByte(13) + "\n"
        let cl: int = String_Length(b.Body)
        var target: string = u.Path
        // Plain HTTP through a proxy : the absolute form (RFC 9112 §3.2.2).
        if (px != null && !isTls) { target = "http://" + u.Host + ":" + String_FromInt(port) + u.Path }
        var s: string = b.Method + " " + target + " HTTP/1.1" + crlf
        s = s + "Host: " + u.Host + crlf
        if (px != null && !isTls && String_Length(px.Auth) > 0) { s = s + "Proxy-Authorization: Basic " + px.Auth + crlf }
        s = s + "Content-Length: " + String_FromInt(cl) + crlf
        s = s + "Connection: close" + crlf
        let hk: List<string> = b.Headers.Keys()
        let hn: int = hk.Count()
        for i in 0..hn {
            let k: string = hk.Get(i)
            s = s + k + ": " + b.Headers.Get(k) + crlf
        }
        s = s + crlf + b.Body

        // Connect (TCP — TLS upgrade follows for https://). Through a proxy :
        // to the proxy ; for https:// a CONNECT tunnel to the server first,
        // then TLS end to end inside it (the proxy sees only ciphertext, and
        // the server's certificate and name are checked exactly as direct).
        var connHost: string = u.Host
        var connPort: int = port
        if (px != null) { connHost = px.Host ; connPort = px.Port }
        let conn = TcpClient_Connect(connHost, connPort)
        if (!TcpClient_IsConnected(conn)) {
            if (px != null) { return HttpResponse.New().Status(0).Text("proxy connect failed (" + connHost + ":" + String_FromInt(connPort) + ")") }
            return HttpResponse.New().Status(0).Text("connect failed")
        }
        if (px != null && isTls) {
            let thost: string = u.Host
            let tauth: string = px.Auth
            let ttmo: int = b.TimeoutMs
            var tst: int = 0
            @c {
                int fd = conn ? conn->_fd : -1;
                amnh_set_timeout(fd, (long) ttmo);
                tst = amnh_tunnel(fd, (const char*) thost, (int) port, (const char*) tauth);
            }
            if (tst != 200) {
                TcpClient_Close(conn)
                return HttpResponse.New().Status(0).Text("proxy refused the tunnel (" + String_FromInt(tst) + ")")
            }
        }

        if (isTls) {
            // v0.11.0: HTTPS path. Everything below is inlined C
            // against the amalgame-tls runtime header — the Tls*
            // classes aren't reachable at AM resolution time when
            // downstream tests only --external net-http's own
            // sources, so we sidestep AM-level dispatch entirely.
            // SNI is set per-connection (Github/Google would
            // otherwise return the wrong cert). ALPN advertises
            // "http/1.1" for parity with the plaintext path.
            let host: string = u.Host
            let req:  string = s
            let timeoutMs: int = b.TimeoutMs
            var status: int = 0
            var rawResp: string = ""
            @c {
                int fd = conn ? conn->_fd : -1;
                if (fd < 0) {
                    status = -1;
                } else {
                    amnh_set_timeout(fd, (long) timeoutMs);
                    AmalgameTlsConfig* cfg =
                        Amalgame_Tls_TlsConfig_Default();
                    cfg = Amalgame_Tls_TlsConfig_WithAlpn(cfg, "http/1.1");
                    AmalgameTlsContext* ctx = _amtls_new_ctx(cfg, false);
                    if (!ctx || !ctx->_ctx) {
                        status = -2;
                    } else {
                        AmalgameTlsStream* stream =
                            Amalgame_Tls_TlsStream_Wrap((i64) fd, ctx, false);
                        if (stream && stream->_ssl && host) {
                            SSL_set_tlsext_host_name((SSL*) stream->_ssl, host);
                        }
                        if (!stream || !stream->_ssl || !amnh_pin_host((SSL*) stream->_ssl, host)
                            || !amnh_handshake(stream)) {
                            status = -3;
                            if (stream) Amalgame_Tls_TlsStream_Close(stream);
                        } else {
                            /* Send request bytes via TLS (again, same
                             * bytes, when a signal interrupted it). */
                            size_t reqLen = req ? strlen(req) : 0;
                            i64 wn = -1;
                            for (int tries = 0; tries < 20; tries++) {
                                errno = 0;
                                wn = Amalgame_Tls_TlsStream_WriteBytes(
                                    stream, req ? req : "", (i64) reqLen);
                                if (wn >= 0 || amnh_read_failed() != 1) break;
                            }
                            if (wn < 0) {
                                status = -4;
                                Amalgame_Tls_TlsStream_Close(stream);
                            } else {
                                /* Read up to 1 MiB into a growable
                                 * buffer; loop until clean close
                                 * (rn <= 0) or the 1 MiB safety ceiling.
                                 *
                                 * BUGFIX (v0.29.3): the old exit condition
                                 * was `total >= cap`, which conflated "the
                                 * CURRENT (still-growable) buffer happens to
                                 * be exactly full" with "the response is
                                 * complete". Whenever a read landed such
                                 * that total exactly filled cap without a
                                 * resize being triggered on that same
                                 * iteration, the loop stopped even though
                                 * the peer still had more bytes queued —
                                 * silently truncating any response whose
                                 * size happened to land on that boundary
                                 * (~64 KiB, then ~128 KiB, etc). Verified in
                                 * the wild: a 105 263-byte JSON response
                                 * truncated to 65 115 bytes, breaking the
                                 * caller's JSON parse with no error at the
                                 * HTTP layer (status still 200). The resize
                                 * block already grows `cap` up to the real
                                 * 1 MiB ceiling as needed, so the only
                                 * legitimate reason to stop reading (short
                                 * of a clean close) is hitting that ceiling. */
                                size_t cap = 65536;
                                size_t total = 0;
                                char* buf = (char*) GC_MALLOC(cap);
                                char chunk[4096];
                                size_t maxBody = 1048576;
                                int timedOut = 0;
                                for (;;) {
                                    errno = 0;
                                    i64 rn = Amalgame_Tls_TlsStream_ReadBytes(
                                        stream, chunk, (i64) sizeof(chunk));
                                    if (rn < 0) {
                                        /* v0.29.9 : a signal is not the end
                                         * (read again), and a timeout is an
                                         * error, never a short response. */
                                        int why = amnh_read_failed();
                                        if (why == 1) continue;
                                        if (why == 2) timedOut = 1;
                                        break;
                                    }
                                    if (rn == 0) break;
                                    if (total + rn > cap) {
                                        size_t newCap = cap * 2;
                                        while (newCap < total + (size_t) rn) newCap *= 2;
                                        if (newCap > maxBody) newCap = maxBody;
                                        char* nbuf = (char*) GC_MALLOC(newCap);
                                        memcpy(nbuf, buf, total);
                                        buf = nbuf;
                                        cap = newCap;
                                    }
                                    size_t can = (size_t) rn;
                                    if (total + can > cap) can = cap - total;
                                    memcpy(buf + total, chunk, can);
                                    total += can;
                                    if (total >= maxBody) break;
                                }
                                Amalgame_Tls_TlsStream_Close(stream);
                                char* nul = (char*) GC_MALLOC(total + 1);
                                if (total > 0) memcpy(nul, buf, total);
                                nul[total] = 0;
                                rawResp = nul;
                                status = timedOut ? -8 : 0;
                            }
                        }
                    }
                }
            }
            TcpClient_Close(conn)
            if (status == -8) {
                return HttpResponse.New().Status(0).Text("timeout")
            }
            if (status == -3) {
                return HttpResponse.New().Status(0).Text("tls error -3 (handshake failed or certificate not valid for " + host + ")")
            }
            if (status != 0) {
                return HttpResponse.New().Status(0).Text("tls error " + String_FromInt(status))
            }
            let resp: HttpResponse = HttpParser.ParseResponse(rawResp)
            if (resp == null) {
                return HttpResponse.New().Status(0).Text("invalid response")
            }
            return resp
        }

        // Plain TCP path (http://).
        //
        // BUGFIX (v0.29.5) — READ UNTIL THE RESPONSE IS ACTUALLY OVER.
        //
        // This used to be a single TcpClient_Receive(). That primitive
        // is one recv(), and one recv() returns whatever has arrived at
        // that instant — never a guarantee of a whole HTTP message. On
        // loopback against a healthy server it failed roughly a third of
        // the time, in two flavours that look nothing alike:
        //
        //   - a fragment of the status line  → ParseResponse fails,
        //     the caller sees "HTTP 0" and blames the network;
        //   - headers without the body       → a perfectly valid
        //     "200 OK" with an empty body, which is far worse: the
        //     caller believes it.
        //
        // The second one is why this mattered: a downstream agent read
        // "200" and an empty desired-state, and kept routing on stale
        // data with nothing anywhere saying so.
        //
        // The request carries `Connection: close`, so end-of-stream IS
        // end-of-message; we read until the server closes. The HTTPS
        // path already did this — only the plaintext path was naive.
        TcpClient_Send(conn, s)
        var raw: string = null
        let plainTimeoutMs: int = b.TimeoutMs
        var plainTimedOut: bool = false
        @c {
            /* A read timeout, which the single-recv version also lacked.
             * Without one, a server that accepts a connection and then
             * says nothing hangs the caller for ever. Thirty seconds of
             * SILENCE — not thirty seconds total — so a large slow body
             * still comes through. */
            amnh_set_timeout(conn->_fd, (long) plainTimeoutMs);   /* v0.29.9 : TimeoutMs, Windows too */
            size_t _cap = 8192, _total = 0;
            char* _buf = (char*) GC_MALLOC(_cap);
            const size_t _MAXB = 1048576;   /* 1 MB cap, as before */
            if (_buf) {
                for (;;) {
                    if (_total + 1 >= _cap) {
                        size_t _n = _cap * 2;
                        if (_n > _MAXB + 1) _n = _MAXB + 1;
                        if (_n <= _cap) break;          /* ceiling reached */
                        char* _nb = (char*) GC_MALLOC(_n);
                        if (!_nb) break;
                        memcpy(_nb, _buf, _total);
                        _buf = _nb; _cap = _n;
                    }
                    ssize_t _r = recv(conn->_fd, _buf + _total, _cap - _total - 1, 0);
                    if (_r < 0) {
                        int _why = amnh_read_failed();
                        if (_why == 1) continue;
                        if (_why == 2) plainTimedOut = true;   /* v0.29.9 : an error, not a short body */
                        break;
                    }
                    if (_r == 0) break;                 /* server closed: done */
                    _total += (size_t) _r;
                    if (_total >= _MAXB) break;
                }
                if (_total > 0) { _buf[_total] = 0; raw = _buf; }
            }
        }
        TcpClient_Close(conn)
        if (plainTimedOut) {
            return HttpResponse.New().Status(0).Text("timeout")
        }
        if (raw == null) {
            return HttpResponse.New().Status(0).Text("read failed")
        }
        let resp: HttpResponse = HttpParser.ParseResponse(raw)
        if (resp == null) {
            return HttpResponse.New().Status(0).Text("invalid response")
        }
        return resp
    }


    private static ParsedUrl ParseUrl(string url) {
        let p = new ParsedUrl()
        let schemeSep: int = String_IndexOf(url, "://")
        if (schemeSep < 0) { return null }
        p.Scheme = String_Substring(url, 0, schemeSep)
        let rest: string = String_Substring(url, schemeSep + 3, String_Length(url) - schemeSep - 3)
        let slashIdx: int = String_IndexOf(rest, "/")
        var hostPort: string = rest
        if (slashIdx < 0) {
            p.Path = "/"
        } else {
            hostPort = String_Substring(rest, 0, slashIdx)
            p.Path   = String_Substring(rest, slashIdx, String_Length(rest) - slashIdx)
        }
        let colonIdx: int = String_IndexOf(hostPort, ":")
        if (colonIdx < 0) {
            p.Host = hostPort
            p.Port = 0
        } else {
            p.Host = String_Substring(hostPort, 0, colonIdx)
            p.Port = String_ToInt(
                String_Substring(hostPort, colonIdx + 1,
                                  String_Length(hostPort) - colonIdx - 1))
        }
        return p
    }
}

