// amalgame-net-http — HttpResponse (response builder + render).
//
// Lives in its own file since v0.4.6 split (was in facade.am
// v0.4.5 and earlier). No behavior change vs the previous combined
// file — just locality.

namespace Amalgame.Net.Http

import Amalgame.Collections
import Amalgame.String

// ─────────────────────────────────────────────────────────────────
// HttpResponse — one outgoing HTTP response, built via fluent API.
// Wire serialization is internal (in `Render()`); user code never
// touches the bytes.
// ─────────────────────────────────────────────────────────────────

public class HttpResponse {
    public StatusCode:  int                       // default 200
    public Headers:     Map<string, string>
    public BodyText:    string
    // v0.9.6 — binary-safe body alternative.
    //
    // When FilePath != "", the wire-out (WriteToH1Conn) reads
    // bytes from disk via H1Conn_RespondFile and ignores BodyText.
    // Render() (sync legacy path) does NOT support FilePath mode —
    // it returns a code_string which is strlen-truncated at the
    // first NUL byte; binary file responses MUST go through the
    // H1Conn path. Set via .File(path) builder.
    public FilePath:    string
    // v0.14.1 — in-memory binary body. When HasBytes is true the
    // wire-out (WriteToH1Conn) ships BodyBytes verbatim via
    // H1Conn_RespondBytesFull (explicit Content-Length, NUL-safe) and
    // ignores BodyText/FilePath. Set via .Bytes(...). The Compress
    // middleware (gzip) and dynamically-generated images use this.
    public BodyBytes:   List<int>
    public HasBytes:    bool

    public HttpResponse() {
        this.StatusCode = 200
        this.Headers    = new Map<string, string>()
        this.BodyText   = ""
        this.FilePath   = ""
        this.BodyBytes  = new List<int>()
        this.HasBytes   = false
    }

    public static HttpResponse New() { return new HttpResponse() }

    public HttpResponse Status(int code) {
        this.StatusCode = code
        return this
    }

    // Set a response header. The value is checked for CR/LF (`\r` or
    // `\n`) — if present, the header is silently dropped and a warning
    // is logged to stderr-equivalent. This blocks HTTP-response-
    // splitting attacks where a user-controlled value contains a
    // newline and turns into "Header1: x\r\nInjected: y" on the wire.
    //
    // For the (rare) legitimate case of needing to pass a value
    // verbatim — e.g. test fixtures that exercise raw bytes — use
    // HeaderUnsafe(name, value), which bypasses the guard.
    //
    // The guard is always on; there is no opt-out config because no
    // legitimate header value contains CR/LF and the cost of leaving
    // the door open is HTTP-response-splitting (CVE-class).
    public HttpResponse Header(string name, string value) {
        if (HttpResponse.HeaderValueHasControl(value)) {
            Console.WriteLine("warning: HttpResponse.Header dropped \"" + name + "\" — CR/LF in value (use HeaderUnsafe to bypass)")
            return this
        }
        this.Headers.Set(name, value)
        return this
    }

    // Set a header without the CR/LF guard. Caller takes full
    // responsibility for value sanity. Used by internal code that
    // builds values from trusted sources (e.g. Cookie.ToHeader)
    // and by tests that exercise edge cases.
    public HttpResponse HeaderUnsafe(string name, string value) {
        this.Headers.Set(name, value)
        return this
    }

    // True if `s` contains a CR or LF byte. Bytes-as-string traversal
    // — String_CharAt1 yields a 1-char string. CR isn't an escape in
    // AM string literals, so build it from byte 13 explicitly.
    private static bool HeaderValueHasControl(string s) {
        let cr: string = String_FromByte(13)
        let lf: string = String_FromByte(10)
        let n: int = String_Length(s)
        var i: int = 0
        while (i < n) {
            let c: string = String_CharAt1(s, i)
            if (c == cr) { return true }
            if (c == lf) { return true }
            i = i + 1
        }
        return false
    }

    public HttpResponse Text(string s) {
        this.BodyText = s
        if (!this.Headers.Has("Content-Type")) {
            this.Headers.Set("Content-Type", "text/plain; charset=utf-8")
        }
        return this
    }

    public HttpResponse Html(string s) {
        this.BodyText = s
        this.Headers.Set("Content-Type", "text/html; charset=utf-8")
        return this
    }

    public HttpResponse Json(string jsonText) {
        this.BodyText = jsonText
        this.Headers.Set("Content-Type", "application/json")
        return this
    }

    public HttpResponse Redirect(string url, bool permanent) {
        if (permanent) {
            this.StatusCode = 308
        } else {
            this.StatusCode = 302
        }
        this.Headers.Set("Location", url)
        return this
    }

    public HttpResponse SetCookie(Cookie c) {
        this.Headers.Set("Set-Cookie", c.ToHeader())
        return this
    }

    // v0.9.6 — set the body to the binary contents of a file. The
    // wire-out path reads it with fopen("rb") + explicit
    // Content-Length, so PNG / JPEG / PDF / WASM survive NUL bytes
    // intact (unlike .Text / .Html / .Json which strlen() the body).
    //
    // Caller is responsible for Content-Type — set it with
    // .Header("Content-Type", "image/png") or let the static-file
    // middleware pick from the file extension.
    //
    // The path is NOT validated here (existence, regularness,
    // permission); the runtime returns -1 on open/read failure and
    // the AM helper Static.Serve translates that to a 500. This
    // setter is library-grade — the static middleware enforces
    // the safety checks (path traversal, IsFile, …) before reaching
    // here.
    public HttpResponse File(string path) {
        this.FilePath = path
        return this
    }

    // v0.14.1 — set an in-memory binary body (NUL-safe). `contentType`
    // is set unless the caller already set one. Wire-out goes through
    // H1Conn_RespondBytesFull, preserving every custom header.
    public HttpResponse Bytes(List<int> data, string contentType) {
        this.BodyBytes = data
        this.HasBytes  = true
        if (String_Length(contentType) > 0
            && !this.Headers.Has("Content-Type")
            && !this.Headers.Has("content-type")) {
            this.Headers.Set("Content-Type", contentType)
        }
        return this
    }

    // Serialize to wire bytes — used by HttpServer.
    public string Render() {
        let crlf: string = String_FromByte(13) + "\n"
        let phrase: string = HttpResponse.ReasonPhrase(this.StatusCode)
        var s: string = "HTTP/1.1 " + String_FromInt(this.StatusCode) + " " + phrase + crlf
        // Content-Length is mandatory in HTTP/1.1 unless chunked.
        this.Headers.Set("Content-Length", String_FromInt(String_Length(this.BodyText)))
        let keys: List<string> = this.Headers.Keys()
        let kn: int = keys.Count()
        for i in 0..kn {
            let k: string = keys.Get(i)
            s = s + k + ": " + this.Headers.Get(k) + crlf
        }
        s = s + crlf + this.BodyText
        return s
    }

    // Standard reason phrases for common codes. Unknown → "Status".
    private static string ReasonPhrase(int code) {
        if (code == 200) { return "OK" }
        if (code == 201) { return "Created" }
        if (code == 204) { return "No Content" }
        if (code == 301) { return "Moved Permanently" }
        if (code == 302) { return "Found" }
        if (code == 304) { return "Not Modified" }
        if (code == 308) { return "Permanent Redirect" }
        if (code == 400) { return "Bad Request" }
        if (code == 401) { return "Unauthorized" }
        if (code == 403) { return "Forbidden" }
        if (code == 404) { return "Not Found" }
        if (code == 405) { return "Method Not Allowed" }
        if (code == 409) { return "Conflict" }
        if (code == 413) { return "Payload Too Large" }
        if (code == 415) { return "Unsupported Media Type" }
        if (code == 429) { return "Too Many Requests" }
        if (code == 500) { return "Internal Server Error" }
        if (code == 502) { return "Bad Gateway" }
        if (code == 503) { return "Service Unavailable" }
        return "Status"
    }

    // ── v0.7.0: Bridge to H1Conn ───────────────────
    //
    // Render this HttpResponse onto the H1Conn that handed us the
    // request. Serializes EVERY entry in this.Headers (Content-Type,
    // Location, Set-Cookie, custom X-… headers, …) — the C runtime
    // handles the status-line, Content-Length, and Connection
    // header. v0.11.1 fixed the long-standing gap where only
    // Content-Type was propagated and Location/Set-Cookie/etc.
    // were silently dropped.
    //
    // The FilePath branch (set via .File(path) for binary-safe
    // file responses) is unchanged — H1Conn_RespondFile still uses
    // the legacy single-Content-Type framing because the Static
    // middleware that calls it doesn't set custom headers.
    //
    // Returns this for chaining (e.g. final-cleanup callers).
    //
    // `conn` is passed as int (pointer-as-i64 handle) for the same
    // self-build reason explained on HttpRequest.FromH1Conn.
    public HttpResponse WriteToH1Conn(conn: int) {
        // v0.14.1: in-memory binary body — marshal BodyBytes to a C
        // buffer and ship via RespondBytesFull (keeps custom headers,
        // explicit Content-Length, NUL-safe). Custom headers built the
        // same way as the text path below; framing headers skipped.
        if (this.HasBytes) {
            let crlfB: string = String_FromByte(13) + String_FromByte(10)
            let keysB: List<string> = this.Headers.Keys()
            let knB: int = keysB.Count()
            var headerBlockB: string = ""
            if (!this.Headers.Has("Content-Type") && !this.Headers.Has("content-type")) {
                headerBlockB = "Content-Type: application/octet-stream" + crlfB
            }
            for i in 0..knB {
                let k: string = keysB.Get(i)
                let kl: string = String_ToLower(k)
                if (kl == "content-length") { continue }
                if (kl == "connection") { continue }
                headerBlockB = headerBlockB + k + ": " + this.Headers.Get(k) + crlfB
            }
            let blen: int = this.BodyBytes.Count()
            @c {
                AmalgameH1Conn* c = (AmalgameH1Conn*)(uintptr_t) conn;
                if (c) {
                    AmalgameList* bl = (AmalgameList*) self->BodyBytes;
                    int cnt = (int) blen;
                    unsigned char* buf = (unsigned char*) GC_MALLOC_ATOMIC((size_t)(cnt > 0 ? cnt : 1));
                    for (int i = 0; i < cnt; i++) {
                        buf[i] = (unsigned char)(intptr_t) AmalgameList_get(bl, i);
                    }
                    Amalgame_Net_Http_H1Conn_RespondBytesFull(c,
                        (i64) self->StatusCode,
                        (code_string) headerBlockB,
                        (i64)(uintptr_t) buf,
                        (i64) cnt);
                }
            }
            return this
        }

        // File responses still go through the legacy path — Static
        // never builds custom headers worth preserving.
        if (String_Length(this.FilePath) > 0) {
            var ctFile: string = "application/octet-stream"
            if (this.Headers.Has("Content-Type")) {
                ctFile = this.Headers.Get("Content-Type")
            } else if (this.Headers.Has("content-type")) {
                ctFile = this.Headers.Get("content-type")
            }
            @c {
                AmalgameH1Conn* c = (AmalgameH1Conn*)(uintptr_t) conn;
                if (c) {
                    Amalgame_Net_Http_H1Conn_RespondFile(c,
                        (i64) self->StatusCode,
                        (code_string) ctFile,
                        (code_string) self->FilePath);
                }
            }
            return this
        }

        // Build the headers block — every entry of this.Headers as
        // "Name: Value\r\n" lines. We MUST NOT include Content-Length
        // or Connection here; the C runtime adds those authoritatively.
        let crlf: string = String_FromByte(13) + String_FromByte(10)
        let keys: List<string> = this.Headers.Keys()
        let kn: int = keys.Count()
        var headerBlock: string = ""
        // Default Content-Type so plain `.New().Text("foo")` callers
        // still get the right Content-Type when they didn't set one.
        if (!this.Headers.Has("Content-Type") && !this.Headers.Has("content-type")) {
            headerBlock = "Content-Type: text/plain; charset=utf-8" + crlf
        }
        for i in 0..kn {
            let k: string = keys.Get(i)
            // Skip framing headers the C runtime owns.
            let kl: string = String_ToLower(k)
            if (kl == "content-length") { continue }
            if (kl == "connection") { continue }
            headerBlock = headerBlock + k + ": " + this.Headers.Get(k) + crlf
        }
        @c {
            AmalgameH1Conn* c = (AmalgameH1Conn*)(uintptr_t) conn;
            if (c) {
                Amalgame_Net_Http_H1Conn_RespondFull(c,
                    (i64) self->StatusCode,
                    (code_string) headerBlock,
                    (code_string) self->BodyText);
            }
        }
        return this
    }
}

